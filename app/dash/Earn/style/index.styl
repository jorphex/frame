.earn, .earnDetails
  min-height 100%
  box-sizing border-box
  padding 8px 7px 42px
  color var(--outerspace)

.earnHero, .earnDetailsHero
  position relative
  margin 0 0 8px
  padding 26px 22px 22px
  border-radius 27px
  background linear-gradient(145deg, var(--ghostA), var(--ghostB))
  border-bottom 2px solid var(--ghostZ)
  box-shadow 0 4px 10px var(--ghostY)

  h1
    margin 4px 0 7px
    font-size 34px
    line-height 1
    font-weight 300
    letter-spacing -1px

  p
    max-width 300px
    margin 0
    font-size 13px
    line-height 19px

.earnEyebrow
  color var(--outerspace06)
  font-size 10px
  font-weight 500
  letter-spacing 1.5px
  text-transform uppercase

.earnRefresh
  position absolute
  top 25px
  right 18px
  border 0
  border-radius 13px
  padding 8px 12px
  color var(--outerspace)
  background var(--ghostC)
  font-family 'MainFont'
  font-size 10px
  letter-spacing 1px
  text-transform uppercase
  cursor pointer

.earnRefresh:disabled
  opacity .5

.earnTabs
  display grid
  grid-template-columns repeat(4, 1fr)
  gap 4px
  margin 12px 1px 18px
  padding 4px
  border-radius 18px
  background var(--ghostA)

  button
    height 35px
    border 0
    border-radius 14px
    color var(--outerspace07)
    background transparent
    font-family 'MainFont'
    font-size 10px
    font-weight 500
    cursor pointer

  .earnTabActive
    color var(--outerspace)
    background var(--ghostC)
    box-shadow 0 2px 5px var(--ghostY)

.earnAccount
  display flex
  align-items center
  gap 8px
  margin 10px 7px 0
  font-size 11px

  span
    color var(--outerspace06)
    text-transform uppercase
    letter-spacing 1px

  strong
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  em
    margin-left auto
    padding 4px 7px
    border-radius 8px
    background var(--ghostB)
    font-size 9px
    font-style normal
    text-transform uppercase

.earnChain
  margin-bottom 24px

.earnChainHeading
  display flex
  align-items flex-end
  justify-content space-between
  padding 0 10px 8px

  h2
    margin 0
    font-size 21px
    font-weight 300

  span
    color var(--outerspace06)
    font-size 10px

.earnSection
  h3
    margin 14px 10px 7px
    color var(--outerspace06)
    font-size 10px
    font-weight 500
    letter-spacing 1.4px
    text-transform uppercase

.earnVault, .earnPosition
  width 100%
  margin 0 0 7px
  border 0
  border-bottom 2px solid var(--ghostZ)
  border-radius 23px
  color var(--outerspace)
  background var(--ghostAZ)
  box-shadow 0 3px 7px var(--ghostY)
  font-family 'MainFont'
  text-align left
  cursor pointer
  transition transform 120ms ease, background 120ms ease

.earnVault
  padding 17px 18px 15px

.earnVault:hover, .earnPosition:hover
  transform translateY(-1px)
  background var(--ghostA)

.earnVaultTop
  display flex
  justify-content space-between
  gap 12px

.earnVaultName, .earnPositionName
  font-size 15px
  font-weight 500

.earnVaultAsset, .earnPositionChain
  margin-top 4px
  color var(--outerspace06)
  font-size 10px
  letter-spacing .4px

.earnApy
  display flex
  flex-direction column
  align-items flex-end
  min-width 78px

  strong
    font-family 'FiraCode'
    font-size 16px
    font-weight 400

  span
    margin-top 3px
    color var(--outerspace06)
    font-size 9px
    text-transform uppercase

.earnVaultMetrics
  display flex
  align-items center
  gap 8px
  margin-top 14px
  color var(--outerspace07)
  font-size 10px

  span + span:before
    content '/'
    margin-right 8px

  .earnPositionPill
    margin-left auto
    padding 4px 7px
    border-radius 8px
    color var(--outerspace)
    background var(--good)

  .earnPositionPill:before
    display none

.earnVaultUnavailable
  opacity .68

.earnVaultReason
  margin-top 10px
  font-size 10px
  line-height 15px

.earnPosition
  display flex
  align-items center
  justify-content space-between
  padding 14px 18px

.earnPositionAmounts
  text-align right
  font-family 'FiraCode'
  font-size 11px
  line-height 17px

.earnNotice
  display flex
  align-items center
  justify-content space-between
  gap 12px
  margin 7px 2px
  padding 11px 14px
  border-radius 15px
  background var(--ghostB)
  font-size 10px
  line-height 15px

  button
    flex none
    border 0
    color var(--outerspace)
    background transparent
    font-family 'MainFont'
    font-size 10px
    font-weight 500
    cursor pointer
    text-decoration underline

.earnNoticeWarn
  border-left 3px solid var(--moon)

.earnTextButton, .earnYearnLink
  margin 8px 8px 12px
  border 0
  color var(--outerspace07)
  background transparent
  font-family 'MainFont'
  font-size 11px
  cursor pointer

.earnDetailsHero
  h1
    font-size 27px

.earnDetailsMetrics
  display grid
  grid-template-columns repeat(3, 1fr)
  gap 5px
  margin 8px 0

.earnMetric
  min-height 70px
  padding 12px 10px
  border-radius 17px
  background var(--ghostA)
  box-sizing border-box

.earnMetricLabel, .earnMetricDetail
  color var(--outerspace06)
  font-size 8px
  letter-spacing .8px
  text-transform uppercase

.earnMetricValue
  margin-top 6px
  font-size 13px
  font-weight 500

.earnMetricDetail
  margin-top 5px
  font-size 7px

.earnVariants, .earnOwned
  margin-top 12px
  padding 16px
  border-radius 22px
  background var(--ghostA)

  h2
    margin 0 0 11px
    font-size 13px
    font-weight 500

.earnVariantGrid
  display grid
  grid-template-columns 1fr 1fr
  gap 6px

.earnVariant
  padding 12px
  border-radius 15px
  background var(--ghostB)

  strong, span
    display block

  strong
    font-size 12px

  span
    margin-top 5px
    font-family 'FiraCode'
    font-size 9px

  p
    margin 8px 0 0
    color var(--outerspace07)
    font-size 9px
    line-height 14px

.earnProductNote
  margin-top 10px
  padding 14px 16px
  border-radius 18px
  background var(--ghostA)
  font-size 10px
  line-height 16px

.earnOwnedLine
  display flex
  justify-content space-between
  padding 7px 0
  border-top 1px solid var(--ghostC)
  font-size 10px

.earnDetailsNotice
  margin-top 12px

.earnActions
  display grid
  grid-template-columns 1fr 1fr
  gap 7px
  margin-top 12px

  button
    height 48px
    border 0
    border-bottom 2px solid var(--ghostZ)
    border-radius 18px
    color var(--outerspace)
    background var(--ghostA)
    box-shadow 0 3px 7px var(--ghostY)
    font-family 'MainFont'
    font-size 12px
    font-weight 500
    cursor pointer

  button:disabled
    opacity .35
    cursor default

.earnYearnLink
  display block
  margin 18px auto 10px
  color var(--outerspace)
  text-decoration underline

.earnDisclosure, .earnFooter
  padding 7px 16px 16px
  color var(--outerspace05)
  font-size 9px
  line-height 14px
  text-align center

.earnState
  display flex
  min-height 100%
  align-items center
  justify-content center
  flex-direction column
  gap 14px
  color var(--outerspace07)
  font-size 12px

  button
    border 0
    border-radius 14px
    padding 10px 16px
    color var(--outerspace)
    background var(--ghostB)
    font-family 'MainFont'
    cursor pointer
